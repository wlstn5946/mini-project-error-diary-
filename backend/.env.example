# backend/.env 로 복사해서 값을 채운다. .env는 커밋하지 않는다.
GEMINI_API_KEY=
# PostgreSQL 접속 주소 (D-058). 비밀번호의 특수문자(@ : / # 등)는 URL 인코딩한다.
# 로컬 예: postgresql://postgres:<비밀번호>@localhost:5432/error_diary
# Supabase 예(Connect → Session pooler): postgresql://postgres.<프로젝트ID>:<비밀번호>@aws-0-<지역>.pooler.supabase.com:5432/postgres
DATABASE_URL=
# 세션 쿠키 Secure 속성 (true/false). 로컬(http)은 false, 배포(https)는 true.
# 비우면 true로 본다.
SESSION_COOKIE_SECURE=false
